# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore 에 있어 절대 커밋되지 않습니다. 키를 코드나 이슈에 붙이지 마세요.

# [필수] Anthropic Claude API 키 — https://console.anthropic.com → API Keys 에서 본인 키 발급
ANTHROPIC_API_KEY=

# 기획에 쓰는 모델 (기본: Claude Opus 5.5)
CLAUDE_MODEL=claude-opus-5-5

# [필수] Blender 실행 파일 경로 — 비워 두면 자동으로 찾아봅니다
#   Windows 예: C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
#   macOS  예: /Applications/Blender.app/Contents/MacOS/Blender
BLENDER_PATH=

# [선택] Higgsfield 토큰 — 보통은 비워 두고 Higgsfield CLI 로그인(`higgsfield auth login`)을 씁니다
HIGGSFIELD_TOKEN=

# [선택] 로컬 서버 주소
HOST=127.0.0.1
PORT=8932

# [선택] "Blender 창에서 재생" 기능용 Higgsfield Blender 애드온 포트
BLENDER_ADDON_PORT=9876
